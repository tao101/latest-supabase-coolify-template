# =============================================================================
# Production Environment - Coolify Deployment
# =============================================================================
# Used by: docker-compose.production.yml
# Setup: Coolify auto-generates SERVICE_* variables when deploying
#
# This file is a REFERENCE showing which variables the production stack uses.
# In Coolify, these are set automatically or via the Coolify UI.
# =============================================================================

# =============================================================================
# CLIENT-SIDE (exposed to browser)
# =============================================================================
# These use Coolify magic variables that resolve to assigned domains.
# Coolify auto-populates SERVICE_FQDN_* based on domain assignments in the UI.

# Public Supabase API URL (browser requests go here)
NEXT_PUBLIC_SUPABASE_URL=https://${SERVICE_FQDN_SUPABASE_KONG}

# Anonymous key for client-side authentication
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SERVICE_SUPABASEANON_KEY}

# Frontend URL for auth redirects
NEXT_PUBLIC_FRONTEND_URL=https://${SERVICE_FQDN_NEXTJS_APP}

# =============================================================================
# SERVER-SIDE ONLY (never exposed to browser)
# =============================================================================

# Internal Docker network URL for server-side requests
# Always use internal hostname - faster, no external DNS resolution
SUPABASE_URL=http://supabase-kong:8000

# Service role key - has elevated privileges, bypasses RLS
SUPABASE_SERVICE_KEY=${SERVICE_SUPABASESERVICE_KEY}

# =============================================================================
# DATABASE CONNECTIONS
# =============================================================================

# Pooled connection via Supavisor (for app queries)
DATABASE_URL=postgres://postgres.${POOLER_TENANT_ID:-dev_tenant}:${SERVICE_PASSWORD_POSTGRES}@supabase-supavisor:5432/${POSTGRES_DB:-postgres}

# Direct connection (for migrations only)
DIRECT_URL=postgres://postgres:${SERVICE_PASSWORD_POSTGRES}@supabase-db:5432/${POSTGRES_DB:-postgres}

# =============================================================================
# AUTH CONFIGURATION
# =============================================================================

# Additional redirect URLs for OAuth (comma-separated)
# ADDITIONAL_REDIRECT_URLS=

# Signup controls
# DISABLE_SIGNUP=false
# ENABLE_EMAIL_SIGNUP=true
# ENABLE_EMAIL_AUTOCONFIRM=false
# ENABLE_ANONYMOUS_USERS=false
# ENABLE_PHONE_SIGNUP=true
# ENABLE_PHONE_AUTOCONFIRM=true

# =============================================================================
# SMTP CONFIGURATION (for email auth)
# =============================================================================

# SMTP_ADMIN_EMAIL=admin@example.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SENDER_NAME=Supabase

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Pooler settings
# POOLER_TENANT_ID=dev_tenant
# POOLER_POOL_MODE=session
# POOLER_DEFAULT_POOL_SIZE=20
# POOLER_MAX_CLIENT_CONN=100

# PostgreSQL database name
# POSTGRES_DB=postgres

# JWT token expiry in seconds (default: 1 hour)
# JWT_EXPIRY=3600

# =============================================================================
# COOLIFY AUTO-GENERATED SECRETS
# =============================================================================
# These are automatically generated by Coolify when you deploy.
# Do NOT set these manually — Coolify manages them.
#
# SERVICE_PASSWORD_POSTGRES
# SERVICE_PASSWORD_JWT
# SERVICE_SUPABASEANON_KEY
# SERVICE_SUPABASESERVICE_KEY
# SERVICE_PASSWORD_LOGFLARE
# SERVICE_PASSWORD_METACRYPTO
# SERVICE_PASSWORD_REALTIME
# SERVICE_PASSWORD_SUPAVISORSECRET
# SERVICE_PASSWORD_VAULTENC
# SERVICE_USER_MINIO
# SERVICE_PASSWORD_MINIO
# SERVICE_USER_ADMIN
# SERVICE_PASSWORD_ADMIN
# SERVICE_FQDN_NEXTJS_APP (assigned via Coolify domain config)
# SERVICE_FQDN_SUPABASE_KONG (assigned via Coolify domain config)
