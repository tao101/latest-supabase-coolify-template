# =============================================================================
# Development Environment - Local Docker Compose
# =============================================================================
# Used by: docker-compose.development.yml
# Setup: ./setup-worktree.sh (auto-configures ports and generates secrets)
# =============================================================================

# =============================================================================
# MULTIPLE WORKTREE SUPPORT
# =============================================================================
# Supports up to 50 simultaneous worktrees with isolated ports and data.
#
# QUICK SETUP (recommended):
#   ./setup-worktree.sh
#
# That's it! The script auto-detects unique ports from your directory name.
# Same directory always gets the same ports - no tracking needed.
#
# MANUAL OVERRIDE (optional):
# Uncomment and set these if you want specific ports instead of auto-detection:
# COMPOSE_PROJECT_NAME=my-project
# NEXTJS_PORT=3001
# KONG_PORT=8000
# POSTGRES_PORT=5432
# POOLER_PORT=6543

# =============================================================================
# CLIENT-SIDE (exposed to browser)
# =============================================================================
# These variables are prefixed with NEXT_PUBLIC_ and will be bundled into
# the client-side JavaScript. Only include non-sensitive values here.

# External URL for browser requests (your public Supabase API URL)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000

# Anonymous key for client-side authentication
# This key is safe to expose - it only allows operations defined by RLS policies
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Frontend URL for auth redirects
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3001

# =============================================================================
# SERVER-SIDE ONLY (never exposed to browser)
# =============================================================================
# These variables are only available in server components, server actions,
# route handlers, and proxy. They should contain sensitive values.

# Internal Docker network URL for server-side requests
# Faster communication without external DNS resolution
SUPABASE_URL=http://supabase-kong:8000

# Service role key - has elevated privileges, bypasses RLS
# NEVER expose this to the client-side
SUPABASE_SERVICE_KEY=your-service-key-here

# =============================================================================
# DATABASE CONNECTIONS
# =============================================================================

# Pooled connection via Supavisor (for app queries)
DATABASE_URL=postgres://postgres.dev_tenant:password@supabase-supavisor:5432/postgres

# Direct connection (for migrations only)
# Bypasses the connection pooler - required for DDL operations and migrations
DIRECT_URL=postgres://postgres:password@supabase-db:5432/postgres

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Pooler tenant ID (should match Supabase config)
# POOLER_TENANT_ID=dev_tenant

# PostgreSQL database name
# POSTGRES_DB=postgres

# =============================================================================
# DEVELOPMENT SECRETS (auto-generated by setup-worktree.sh)
# =============================================================================
# These are automatically generated when you run ./setup-worktree.sh
# DO NOT set these manually unless you know what you're doing
#
# SERVICE_PASSWORD_POSTGRES=<auto-generated>
# SERVICE_PASSWORD_JWT=<auto-generated - uses Supabase demo JWT secret>
# SERVICE_SUPABASEANON_KEY=<auto-generated - uses Supabase demo anon key>
# SERVICE_SUPABASESERVICE_KEY=<auto-generated - uses Supabase demo service key>
# SERVICE_PASSWORD_LOGFLARE=<auto-generated>
# SERVICE_PASSWORD_METACRYPTO=<auto-generated>
# SERVICE_PASSWORD_REALTIME=<auto-generated>
# SERVICE_PASSWORD_SUPAVISORSECRET=<auto-generated>
# SERVICE_PASSWORD_VAULTENC=<auto-generated>
# SERVICE_USER_MINIO=minioadmin
# SERVICE_PASSWORD_MINIO=<auto-generated>
# SERVICE_USER_ADMIN=admin
# SERVICE_PASSWORD_ADMIN=<auto-generated>
